{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "emmylua_new",
            "request": "launch",
            "name": "EmmyLua New Debug",
            "host": "localhost",
            "port": 9966,
            "ext": [
                ".lua",
                ".lua.txt",
                ".lua.bytes"
            ],
            "ideConnectDebugger": true
        },
        {
            "type": "lua",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/execute_header_tool.lua"
        },
        {
            "name": "(Windows) C++ Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "NilouEditor",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/NilouEditor.exe",
        },
        {
            "name": "NilouGame",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/NilouGame.exe",
        },
        {
            "name": "NilouHeaderTool Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/NilouHeaderTool.exe",
            "args": [
                "-InputDirectory=D:\\Nilou\\Engine\\Source\\Runtime\\Engine", 
                "-OutputDirectory=D:\\Nilou\\Engine\\Source\\Runtime\\Engine\\Generated", 
                "-x", "c++", "-std=c++20", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\Engine\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\Engine\\Classes", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\base64", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\spirv-reflect\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\RHI\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\shaderc\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\VulkanRHI\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\CoreUObject\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\Core\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\glfw\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\headeronlys", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\RenderCore\\Public", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\include", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\stb_image", 
                "-I", "D:\\Nilou\\Engine\\Source\\ThirdParty\\tinygltf", 
                "-include", "D:\\Nilou\\Engine\\Source\\Runtime\\Launch\\Generated\\Definitions.Launch.h"
            ]
        },
        {
            "name": "NilouShaderTool Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/NilouShaderTool.exe",
            "args": [
                "-InputDirectory=D:\\Nilou\\Engine\\Shaders", 
                "-OutputDirectory=D:\\Nilou\\Engine\\Source\\Runtime\\ShaderBindings", 
                // "-SearchDirectories=D:\\Nilou\\Engine\\Source\\Runtime\\Core\\Shaders,D:\\Nilou\\Engine\\Source\\Runtime\\CoreUObject\\Shaders,D:\\Nilou\\Engine\\Source\\Runtime\\RHI\\Shaders,D:\\Nilou\\Engine\\Source\\Runtime\\RenderCore\\Shaders,D:\\Nilou\\Engine\\Source\\Runtime\\VulkanRHI\\Shaders,D:\\Nilou\\Engine\\Source\\Runtime\\Engine\\Shaders",
                "-SearchDirectories=D:\\Nilou\\Engine\\Shaders\\Public",
                "-ForceRegenerate"
            ]
        },
        {
            "name": "TestSlang",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/test-slang.exe",
        },
        {
            "name": "TestSlangReflection",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/test-slang-reflection.exe",
        }
    ]
}