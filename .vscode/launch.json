{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "emmylua_new",
            "request": "launch",
            "name": "EmmyLua New Debug",
            "host": "localhost",
            "port": 9966,
            "ext": [
                ".lua",
                ".lua.txt",
                ".lua.bytes"
            ],
            "ideConnectDebugger": true
        },
        {
            "type": "lua",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/execute_header_tool.lua"
        },
        {
            "name": "(Windows) C++ Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Nilou Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/Nilou.exe",
        },
        {
            "name": "NilouHeaderTool Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/build/windows/x64/debug/",
            "program": "${workspaceFolder}/build/windows/x64/debug/NilouHeaderTool.exe",
            "args": [
                "-InputDirectory=D:\\Nilou\\Engine\\Source\\Runtime\\RHI", 
                "-OutputDirectory=D:\\Nilou\\Engine\\Source\\Runtime\\RHI\\Generated", 
                "-x", "c++", "-std=c++20", 
                "-I", "D:\\Nilou\\Engine\\Source\\Runtime\\RHI\\Public", 
                "-I", "D:\\Nilou\\External\\include"
            ]
        }
    ]
}